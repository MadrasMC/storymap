+/*
+ * Like libdeflate_deflate_compress(), but for one chunk of a stream that goes
+ * on: unless 'is_final', no block is final and the output ends with an empty
+ * stored block, on a byte boundary, as zlib's Z_SYNC_FLUSH does, so the next
+ * chunk's output can follow it.  Each chunk is compressed without the history
+ * of the ones before it.
+ */
+LIBDEFLATEAPI size_t
+libdeflate_deflate_compress_chunk(struct libdeflate_compressor *c,
+				  const void *in, size_t in_nbytes,
+				  void *out, size_t out_nbytes_avail,
+				  int is_final)
+{
+	struct deflate_output_bitstream os;
+	u8 *out_next;
+
+	if (is_final)
+		return libdeflate_deflate_compress(c, in, in_nbytes,
+						   out, out_nbytes_avail);
+
+	/* Stored blocks already end on a byte boundary. */
+	if (unlikely(in_nbytes <= c->max_passthrough_size))
+		return deflate_compress_none(in, in_nbytes,
+					     out, out_nbytes_avail, false);
+
+	/*
+	 * The empty stored block takes up to 1 more byte than the bits left
+	 * over, and 4 for LEN and NLEN.
+	 */
+	if (out_nbytes_avail < 6)
+		return 0;
+	os.bitbuf = 0;
+	os.bitcount = 0;
+	os.next = out;
+	os.end = os.next + out_nbytes_avail - 5;
+	os.overflow = false;
+
+	c->continues = true;
+	(*c->impl)(c, in, in_nbytes, &os);
+	c->continues = false;
+	if (os.overflow)
+		return 0;
+
+	/* BFINAL 0 and BTYPE 00, then align to a byte boundary. */
+	ASSERT(os.bitcount <= 7);
+	out_next = os.next;
+	*out_next++ = os.bitbuf;
+	if (os.bitcount + 3 > 8)
+		*out_next++ = 0;
+	put_unaligned_le16(0, out_next);
+	put_unaligned_le16(0xFFFF, out_next + 2);
+	out_next += 4;
+	return out_next - (u8 *)out;
+}
